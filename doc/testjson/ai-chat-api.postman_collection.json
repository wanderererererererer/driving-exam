          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/student/ai/sessions?pageNum=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "student", "ai", "sessions"],
              "query": [
                { "key": "pageNum", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"code = 200\", function () { pm.expect(j.code).to.eql(200); });",
                  "pm.test(\"data 是分页结构\", function () { pm.expect(j.data).to.have.property(\"total\"); });",
                  "var sid = pm.collectionVariables.get(\"sessionId\");",
                  "var found = (j.data.records || []).filter(function (s) { return s.sessionId === sid; });",
