              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"code = 200\", function () { pm.expect(j.code).to.eql(200); });",
                  "var recs = j.data.records || [];",
                  "pm.test(\"错题本非空（造数据成功）\", function () { pm.expect(recs.length).to.be.at.least(3); });",
                  "",
                  "// 按 questionId 保存 wrong_book.id，供后面 PUT /{id}/mastered 使用",
                  "recs.forEach(function (r) { pm.collectionVariables.set(\"wbId_\" + r.questionId, String(r.id)); });",
                  "// 保存「高频错」的 questionId 集合，供验证 retry 优先抽高频错",
                  "var hf = recs.filter(function (r) { return r.category === \"HIGH_FREQUENCY\"; })",
                  "              .map(function (r) { return r.questionId; });",
                  "pm.collectionVariables.set(\"highFreqIds\", JSON.stringify(hf));",
                  "console.log(\"highFreqIds =\", JSON.stringify(hf));",
                  "",
                  "pm.test(\"至少存在 1 条高频错（Q1 应已成立）\", function () { pm.expect(hf.length).to.be.at.least(1); });",
                  "pm.test(\"每条都带 category 字段\", function () { recs.forEach(function (r) { pm.expect(r).to.have.property(\"category\"); }); });"
                ]
              }
            }
          ]
        }
