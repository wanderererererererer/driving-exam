              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"code = 200\", function () { pm.expect(j.code).to.eql(200); });",
                  "pm.test(\"返回 1 道\", function () { pm.expect(j.data.length).to.eql(1); });",
                  "",
                  "// 抽到的题必须属于「高频错」集合（HT 不够时才补待攻克，此处高频有货）",
                  "var allowed = JSON.parse(pm.collectionVariables.get(\"highFreqIds\") || \"[]\");",
                  "pm.test(\"抽中的题来自高频错\", function () {",
                  "  pm.expect(allowed).to.include(j.data[0].id);",
                  "});",
                  "",
                  "// 防作弊：不返回答案与解析",
                  "pm.test(\"不含 answer\", function () { pm.expect(j.data[0]).to.not.have.property(\"answer\"); });",
                  "pm.test(\"不含 analysis\", function () { pm.expect(j.data[0]).to.not.have.property(\"analysis\"); });",
                  "pm.test(\"选项不含 isCorrect\", function () { (j.data[0].options||[]).forEach(function (o) { pm.expect(o).to.not.have.property(\"isCorrect\"); }); });"
                ]
              }
            }
          ]
        }
      ]
