                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.test(\"code = 200\", function () { pm.expect(j.code).to.eql(200); });",
                  "pm.test(\"含四个字段\", function () { [\"pending\",\"highFrequency\",\"mastered\",\"total\"].forEach(function (k) { pm.expect(j.data).to.have.property(k); }); });",
                  "pm.test(\"三项之和 == total\", function () {",
                  "  pm.expect(j.data.pending + j.data.highFrequency + j.data.mastered).to.eql(j.data.total);",
                  "});",
                  "pm.test(\"不是 null（空集也应为 0）\", function () {",
                  "  [\"pending\",\"highFrequency\",\"mastered\",\"total\"].forEach(function (k) { pm.expect(j.data[k]).to.not.be.null; });",
                  "});",
                  "pm.test(\"total >= 3\", function () { pm.expect(j.data.total).to.be.at.least(3); });"
                ]
              }
            }
          ]
        }
      ]
