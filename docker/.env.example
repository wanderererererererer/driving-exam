# 复制为 docker/.env 后修改；不要把真实值提交到 Git。
# 所有 Compose 命令必须显式使用：--env-file docker/.env -p driving-exam-accept
# MYSQL_ROOT_PASSWORD 必须设置；JWT_SECRET 至少 32 字节随机字符串。
# 首次验收使用独立数据库名和独立宿主机端口，避免与本机 MySQL/后端冲突。
MYSQL_DATABASE=driving_exam_docker_accept
# MySQL root：仅用于初始化/管理员维护，不作为 Spring Boot 运行时账号
MYSQL_ROOT_PASSWORD=change-me
# 应用运行时账号：仅目标数据库的 SELECT/INSERT/UPDATE/DELETE（初始化脚本创建）
APP_DB_USER=drv_app
APP_DB_PASSWORD=change-me-app-password
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes

# AI / RAG：Qdrant 随默认 Compose 启动；AI 问答还需要以下外部 Key。
# 首次部署后，使用管理员账号调用 POST /api/admin/rag/ingest 执行一次知识入库。
# 不配置 Key 不会阻止应用启动，但 AI 问答/知识入库会返回明确错误。
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
QDRANT_API_KEY=
QDRANT_BASE_URL=http://qdrant:6333
QDRANT_COLLECTION=driving_exam_kb_dev
QDRANT_VECTOR_SIZE=1024

# 端口（首次验收使用独立端口，避免占用本机 3306/8080/80）
FRONTEND_PORT=18081
BACKEND_PORT=18080
MYSQL_PORT=13306
QDRANT_HTTP_PORT=16333
QDRANT_GRPC_PORT=16334
