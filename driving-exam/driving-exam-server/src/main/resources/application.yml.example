# ============================================================
# 后端主配置【模板】—— application.yml.example
#
# 用法：复制为 application.yml 后，按需提供下列环境变量再启动。
#   cp application.yml.example application.yml
#   export DB_URL='jdbc:mysql://localhost:3306/driving_exam?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true'
#   export DB_USERNAME='root'
#   export DB_PASSWORD='<本机数据库口令>'
#   export DEEPSEEK_API_KEY='<DeepSeek API Key>'
#   export JWT_SECRET='<随机长字符串>'
#
# 安全约定：
#   - 本文件**不含任何真实凭据**；下方敏感项均为【无默认值】环境变量占位符。
#   - 真正的 application.yml 已被 .gitignore 排除，请勿提交。
# ============================================================

server:
  port: 8080

spring:
  application:
    name: driving-exam-server
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 12MB
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 数据库连接：全部改为无默认值环境变量（缺失即启动失败，绝不回退真实口令）
    url: ${DB_URL}
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
  jackson:
    # 时间格式不在此配置：LocalDateTime 的序列化/反序列化统一由 JacksonConfig 控制
    # data 为 null 时保留字段（不剔除）
    default-property-inclusion: always

mybatis-plus:
  # Mapper XML 位置
  mapper-locations: classpath*:mapper/**/*.xml
  # 实体所在包（已迁至 pojo 模块）
  type-aliases-package: com.driving.exam.pojo.entity
  configuration:
    # 下划线转驼峰
    map-underscore-to-camel-case: true
    # 开发期打印 SQL，上线可去掉
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    banner: false
    db-config:
      id-type: auto
      # 逻辑删除仅用于 5 张主数据表，由实体 @TableLogic 显式声明，此处不全局开启

# 大语言模型（DeepSeek）
# 说明：model 用官方通用别名 deepseek-chat（实测返回的 model 为 deepseek-flash，
#      是服务端路由后的实际模型；别名将来升级无需改配置）
deepseek:
  # API Key 改为无默认值环境变量（原文件曾带 ${DEEPSEEK_API_KEY:} 空默认，此处同样不留真实值）
  api-key: ${DEEPSEEK_API_KEY}
  base-url: https://api.deepseek.com
  model: deepseek-chat
  temperature: 1.0
  top-p: 1.0
  # 建连超时（毫秒）
  connect-timeout: 5000
  # 读超时（毫秒）：非流式请求下，服务端在模型生成期间不返回任何字节，
  # 该值需覆盖"整段生成时间"，故放宽到 60s
  read-timeout: 60000

# JWT —— 用户模块启用
jwt:
  # 密钥改为无默认值环境变量（原文件曾带示例默认值，此处不留任何默认）
  secret: ${JWT_SECRET}
  expire-seconds: 86400

logging:
  level:
    com.driving.exam: debug

# ============================================================
# RAG Embedding（SiliconFlow BGE-M3）—— 仅当启用 RAG 时需要
# 真实 Key 仅置于本机环境变量 SILICONFLOW_API_KEY，勿写入本文件
# ============================================================
embedding:
  # 无默认值占位：缺环境变量时为空，客户端调用前判空并报错（不影响应用启动）
  api-key: ${SILICONFLOW_API_KEY:}
  base-url: https://api.siliconflow.cn/v1
  model: BAAI/bge-m3
  encoding-format: float
  connect-timeout: 5000
  read-timeout: 30000

# ============================================================
# RAG 向量库（Qdrant REST）—— 仅当启用 RAG 时使用；本地可无鉴权
# api-key 如需则仅通过环境变量 QDRANT_API_KEY 提供（勿写真实值）
# vector-size 固定为 1024：依据 2026-10-18 已完成的 BGE-M3 真实 Embedding
#   与 Qdrant 写入/检索验证（R2.4 / R3），入库与检索共用该维度配置。
# collection 当前为已入库验证的开发集合 driving_exam_kb_dev（39 个点）；
#    ⚠️ 这是当前项目阶段的安全默认选择，不代表已批准生产部署方案——
#    正式部署或切换数据源前必须重新确认目标集合；严禁指向集成测试集合
#    driving_exam_kb_it（保持为空），生产集合 driving_exam_kb 的启用需单独评审。
# ============================================================
qdrant:
  base-url: http://localhost:6333
  api-key: ${QDRANT_API_KEY:}
  # 当前阶段已验证的开发集合（正式切换前必须重新确认）
  collection: driving_exam_kb_dev
  vector-size: 1024
  distance: Cosine
  connect-timeout: 5000
  read-timeout: 30000

# ============================================================
# 模拟考试超时收尾（定时任务）
# enabled=false 可用于集成测试；生产默认开启。
# ============================================================
exam:
  timeout-scan-enabled: true
  timeout-scan-ms: 60000
  timeout-scan-initial-ms: 30000
